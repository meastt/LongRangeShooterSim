---
import Base from '../layouts/Base.astro';

/** Snapshot from packages/solver harness. Re-run `npm run test:solver` and update after solver changes. */
const fixtures = [
  {
    id: 'g7-308-175smk-2600fps',
    label: '.308 Win · 175gr SMK · G7 0.243 · 2600 fps',
    truth: 'JBM-derived G7 table ground truth',
    at1000: { pathIn: -432.0, holdMil: 12.001, velFps: 1089, tolIn: 2.0 },
    status: 'PASS',
  },
  {
    id: 'g7-65creedmoor-140eldm-2710fps',
    label: '6.5 Creedmoor · 140gr ELD-M · G7 0.315 · 2710 fps',
    truth: 'Published trajectory table fixtures',
    at1000: { pathIn: -317.6, holdMil: 8.823, velFps: 1485, tolIn: 2.5 },
    status: 'PASS',
  },
  {
    id: 'g7-7mm-prc-180eldm-2950fps',
    label: '7mm PRC · 180gr ELD-M · G7 0.401 · 2950 fps',
    truth: 'Published trajectory table fixtures',
    at1000: { pathIn: -235.3, holdMil: 6.536, velFps: 1877, tolIn: 2.5 },
    status: 'PASS',
  },
];

const gate = 'PR blocked if any fixture exceeds 0.05 mil deviation at 1000 yards — current harness validates 74 unit & trajectory tests across RK4 integrator, wind, corrections, BLE, and profile importers.';
---
<Base
  title="Solver Validation | Aim Ballistics"
  description="Public validation results for the Aim on-device ballistics solver against published trajectory fixtures."
>
<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(20px, 5vw, 60px);
    height: 80px;
    background: rgba(8, 8, 8, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 0.15em;
    color: #fff;
    font-style: italic;
    text-decoration: none;
  }
  .brand span {
    color: var(--primary);
  }
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 140px clamp(20px, 5vw, 40px) 100px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--dim);
    text-transform: uppercase;
    margin-bottom: 48px;
    text-decoration: none;
  }
  .back:hover {
    color: var(--primary);
  }
  .spec-tag {
    display: inline-block;
    background: var(--primary);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    margin-bottom: 20px;
  }
  h1 {
    font-family: var(--font-sans);
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .lede {
    font-size: 16px;
    color: #aaa;
    line-height: 1.85;
    margin-bottom: 32px;
    max-width: 640px;
  }
  .gate {
    border-left: 4px solid var(--primary);
    background: var(--surface);
    padding: 20px 24px;
    margin-bottom: 48px;
  }
  .gate-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--primary);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .gate p {
    font-size: 13px;
    font-family: var(--font-mono);
    color: #ccc;
    margin: 0;
    line-height: 1.7;
  }
  h2 {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 600;
    color: #fff;
    text-transform: uppercase;
    margin: 48px 0 16px;
    border-left: 4px solid var(--primary);
    padding-left: 16px;
  }
  .card {
    border: 1px solid var(--border);
    background: rgba(18, 18, 18, 0.6);
    padding: 24px;
    margin-bottom: 16px;
  }
  .card h3 {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #fff;
    margin: 0 0 8px;
    letter-spacing: 0.04em;
  }
  .pass {
    color: #22C55E;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .stat {
    border: 1px solid var(--border);
    padding: 12px;
    background: rgba(8, 8, 8, 0.4);
  }
  .stat-k {
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--dim);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .stat-v {
    font-size: 16px;
    color: #fff;
    font-weight: 700;
    font-family: var(--font-mono);
  }
  footer {
    border-top: 1px solid var(--border);
    padding: 32px clamp(20px, 5vw, 60px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  footer a {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    color: var(--dim);
    text-transform: uppercase;
    text-decoration: none;
  }
  footer a:hover {
    color: var(--primary);
  }
  @media(max-width: 640px) {
    .stats { grid-template-columns: 1fr 1fr; }
  }
</style>

<nav>
  <a href="/" class="brand">AIM<span>.</span></a>
  <a href="/" class="back" style="margin:0;">← Home</a>
</nav>

<main>
  <a href="/" class="back">← Back to Aim</a>
  <span class="spec-tag">Public Trust Signal</span>
  <h1>Solver Validation</h1>
  <p class="lede">
    Every build runs an on-device Runge-Kutta 4th Order (RK4) modified point-mass solver against published trajectory fixtures. We publish validation results publicly so long-range hunters can verify physics accuracy before hitting the field.
  </p>

  <div class="gate">
    <div class="gate-label">CI Quality Gate</div>
    <p>{gate}</p>
  </div>

  <h2>Physics Surface Implemented</h2>
  <p class="lede" style="margin-bottom:0;">
    RK4 numerical integration &middot; G1/G7 standard drag curves &middot; multi-segment velocity BC &middot; atmospheric density altitude &middot; Coriolis deflection &middot; Miller stability spin drift &middot; aerodynamic jump &middot; cant compensation &middot; Hunter WEZ vital-zone probability &middot; 1:1 scope turret tape generator.
  </p>

  <h2>Current Harness Snapshot (74/74 Tests Passing)</h2>
  {fixtures.map((f) => (
    <div class="card">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:baseline;flex-wrap:wrap;margin-bottom:12px;">
        <h3>{f.label}</h3>
        <span class="pass">{f.status}</span>
      </div>
      <div class="stats">
        <div class="stat">
          <div class="stat-k">Drop @ 1000yd</div>
          <div class="stat-v">{f.at1000.pathIn.toFixed(1)}"</div>
        </div>
        <div class="stat">
          <div class="stat-k">Hold @ 1000yd</div>
          <div class="stat-v">{f.at1000.holdMil.toFixed(3)} MIL</div>
        </div>
        <div class="stat">
          <div class="stat-k">Vel @ 1000yd</div>
          <div class="stat-v">{f.at1000.velFps} FPS</div>
        </div>
        <div class="stat">
          <div class="stat-k">Accuracy</div>
          <div class="stat-v">&lt; 0.05 MIL</div>
        </div>
      </div>
    </div>
  ))}
</main>

<footer>
  <a href="/">&copy; 2026 Aim Ballistics</a>
  <a href="/">Return to Home</a>
</footer>
</Base>
